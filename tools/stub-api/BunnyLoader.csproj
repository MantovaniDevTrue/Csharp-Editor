<Project Sdk="Microsoft.NET.Sdk">
  <!-- So para o teste no emulador: um pedaco da API do Bunny, para exercitar o compilador do app.
       O BunnyLoader.dll real depende do dump do jogo, que nao fica em nenhum repositorio. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BunnyLoader</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
